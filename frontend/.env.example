# ============================================================
# VARIABLES DE ENTORNO - COPIA ESTE ARCHIVO A .env.local
# ============================================================

# Base de datos PostgreSQL (Neon - vercel.com/storage o neon.tech)
# Obtén tu cadena de conexión desde: https://neon.tech o Vercel Storage
DATABASE_URL="postgresql://usuario:password@host/base_datos?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://usuario:password@host/base_datos?sslmode=require"

# NextAuth - Genera con: openssl rand -base64 32
NEXTAUTH_SECRET="tu-secreto-super-seguro-aqui"
NEXTAUTH_URL="http://localhost:3000"
# En producción: NEXTAUTH_URL="https://tu-app.vercel.app"

# Información del colegio (opcional, aparece en la UI)
NEXT_PUBLIC_SCHOOL_NAME="Institución Educativa"
NEXT_PUBLIC_SCHOOL_YEAR="2025"

# Email admin inicial (se crea automáticamente al hacer seed)
ADMIN_EMAIL="admin@colegio.edu"
ADMIN_PASSWORD="Admin2025!"
ADMIN_NAME="Administrador"
